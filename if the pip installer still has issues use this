#!/bin/bash

echo "🧼 Cleaning previous install..."
sudo rm -rf /opt/hi-ai-venv
sudo rm -f /usr/local/bin/hi-ai

echo "📦 Installing dependencies..."
sudo apt update
sudo apt install -y python3 python3-venv python3-pip

echo "🔧 Creating virtual environment..."
python3 -m venv /opt/hi-ai-venv
source /opt/hi-ai-venv/bin/activate

echo "📦 Installing Python packages..."
pip install --upgrade pip
pip install openai flask blinker

echo "🧠 Writing hi-ai script..."
cat << 'EOF' | sudo tee /opt/hi-ai-venv/bin/hi-ai > /dev/null
#!/usr/bin/env python3
import openai, subprocess, readline, os
openai.api_key = 

while True:
    try:
        prompt = input("🤖 hi-ai > ")
        if prompt.strip().lower() in ["exit", "quit"]:
            break
        print("🧠 Thinking...")
        res = openai.ChatCompletion.create(
            model="gpt-4-turbo",
            messages=[{"role": "user", "content": prompt}]
        )
        reply = res.choices[0].message.content.strip()
        print(f"💬 {reply}")
        if "```bash" in reply:
            cmd = reply.split("```bash")[1].split("```")[0].strip()
            print(f"⚡ Running: {cmd}")
            subprocess.run(cmd, shell=True)
    except Exception as e:
        print(f"❌ Error: {e}")
EOF

sudo chmod +x /opt/hi-ai-venv/bin/hi-ai

echo "📎 Creating launcher..."
cat << 'EOF' | sudo tee /usr/local/bin/hi-ai > /dev/null
#!/bin/bash
source /opt/hi-ai-venv/bin/activate
python3 /opt/hi-ai-venv/bin/hi-ai "$@"
EOF

sudo chmod +x /usr/local/bin/hi-ai

echo "✅ hi-ai installed. Just type: hi-ai"
